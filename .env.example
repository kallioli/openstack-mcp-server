# HTTP listener
PORT=3000
HOST=0.0.0.0

# Persistent data (SQLite database: connections, MCP tokens, settings). Mount a volume here.
DATA_DIR=./data
# Key encrypting the stored OpenStack credentials (>= 32 chars). If unset, one is generated in
# DATA_DIR/secret.key: back it up, stored credentials cannot be decrypted without it.
# MCP_SECRET_KEY=

# Admin portal (separate port, keep it private: do not publish it through the public proxy)
ADMIN_ENABLED=true
ADMIN_PORT=9090
# ADMIN_HOST=0.0.0.0
# Sets/resets the admin password at startup (>= 12 chars). If unset, the first launch runs
# an onboarding wizard in the portal, unlocked by a one-time setup code printed in the logs.
# ADMIN_PASSWORD=

# Everything below can instead be configured in the portal (stored in the database, applied
# without restart). A variable set here takes precedence and locks the field in the portal.

# Public URL of this server, as seen by clients (required for OAuth)
# PUBLIC_URL=https://mcp.example.com

# OAuth "Sign in" through an OpenID Connect identity provider (Keycloak, Entra ID, Authentik...).
# Register a confidential client with redirect URI ${PUBLIC_URL}/oauth/callback.
# OIDC_ISSUER=https://sso.example.com/realms/cloud
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_SCOPES=openid profile email
# Random secret (>= 32 chars) sealing OAuth clients, codes and tokens. Optional: generated and
# stored (encrypted) in the database when unset. Rotating it signs every OAuth user out.
# OAUTH_SECRET=

# Keystone federation (optional): OAuth users then act with their own OpenStack identity, the
# identity provider's access token being exchanged at
# ${OS_FEDERATION_AUTH_URL}/v3/OS-FEDERATION/identity_providers/${OS_FEDERATION_IDP}/protocols/${OS_FEDERATION_PROTOCOL}/auth
# OS_FEDERATION_AUTH_URL=https://keystone.example.com:5000/v3
# OS_FEDERATION_IDP=sso
# OS_FEDERATION_PROTOCOL=openid
# OS_FEDERATION_REGION=RegionOne

# Set when running behind a reverse proxy (express "trust proxy" value), e.g. 1
# TRUST_PROXY=1

# Static API keys (legacy setups): clients send Authorization: Bearer <one of these keys> and act
# with the cloud described by the usual OS_* variables below (also used by --stdio mode).
# MCP_API_KEYS=key-1,key-2
# OS_AUTH_URL=https://keystone.example.com:5000/v3
# OS_USERNAME=
# OS_PASSWORD=
# OS_USER_DOMAIN_NAME=Default
# OS_PROJECT_NAME=
# OS_PROJECT_DOMAIN_NAME=Default
# OS_REGION_NAME=RegionOne
# OS_INTERFACE=public
# or an application credential:
# OS_AUTH_TYPE=v3applicationcredential
# OS_APPLICATION_CREDENTIAL_ID=
# OS_APPLICATION_CREDENTIAL_SECRET=

# Hide the write tool (POST/PUT/PATCH/DELETE)
OPENSTACK_READ_ONLY=false

# Host header allow-list (DNS rebinding protection), e.g. mcp.example.com
# MCP_ALLOWED_HOSTS=

# Truncate API responses beyond this many characters
MAX_RESPONSE_CHARS=60000

# Private certificate authority of your cloud (Node.js reads it at startup)
# NODE_EXTRA_CA_CERTS=/certs/ca.pem

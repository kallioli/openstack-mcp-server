          },
          {
            "name": "offset",
            "in": "query",
            "description": "Number of items to skip.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "name",
            "in": "query",
            "description": "Filter by name.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "type",
            "in": "query",
            "description": "generic, rsa or certificate.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {}
            }
          }
        }
      },
      "post": {
        "summary": "Create container",
        "description": "Groups secrets in a container (generic, rsa or certificate, e.g. for a TLS listener).",
        "tags": [
          "containers"
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {}
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "type"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "generic",
                      "rsa",
                      "certificate"
                    ]
                  },
                  "secret_refs": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "type": "string",
                          "description": "e.g. certificate, private_key, intermediates"
                        },
                        "secret_ref": {
                          "type": "string",
                          "description": "URL of the secret."
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },

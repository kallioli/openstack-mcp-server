{
  "openapi": "3.1.0",
  "info": {
    "title": "OpenStack Key Manager API (curated)",
    "version": "1.0"
  },
  "paths": {
    "/v1/secrets": {
      "get": {
        "summary": "List secrets",
        "description": "Lists the secrets of the project (metadata only, never the payload).",
        "tags": [
          "secrets"
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of items.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "description": "Number of items to skip.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "name",
            "in": "query",
            "description": "Filter by name.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "alg",
            "in": "query",
            "description": "Filter by algorithm.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "mode",
            "in": "query",
            "description": "Filter by mode.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "bits",
            "in": "query",
            "description": "Filter by bit length.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "secret_type",
            "in": "query",
            "description": "Filter by type.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "acl_only",
            "in": "query",
            "description": "Only secrets shared with you through an ACL.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "description": "e.g. created:desc",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {}
            }
          }
        }
      },
      "post": {
        "summary": "Create secret",
        "description": "Stores a secret, with or without its payload.",
        "tags": [
          "secrets"
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {}
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "expiration": {
                    "type": "string",
                    "description": "ISO 8601 expiry date."
                  },
                  "algorithm": {
                    "type": "string",
                    "description": "e.g. aes"
                  },
                  "bit_length": {
                    "type": "integer"
                  },
                  "mode": {
                    "type": "string",
                    "description": "e.g. cbc"
                  },
                  "payload": {
                    "type": "string",
                    "description": "The secret itself. Omit it to upload it later with PUT."
                  },
                  "payload_content_type": {
                    "type": "string",
                    "description": "text/plain or application/octet-stream (required with payload)."
                  },
                  "payload_content_encoding": {
                    "type": "string",
                    "description": "base64 for binary payloads."
                  },
                  "secret_type": {
                    "type": "string",
                    "enum": [
                      "symmetric",
                      "public",
                      "private",
                      "passphrase",
                      "certificate",
                      "opaque"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/secrets/{uuid}": {
      "get": {
        "summary": "Show secret metadata",
        "description": "Shows the metadata of a secret (not its payload).",
        "tags": [
          "secrets"
        ],
        "parameters": [
          {
            "name": "uuid",
            "in": "path",
            "description": "UUID of the item.",
            "schema": {
              "type": "string"
            },
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {}
            }
          }
        }
      },
      "put": {
        "summary": "Upload secret payload",
        "description": "Uploads the payload of a secret created without one. Pass the payload as a string body and its Content-Type header (text/plain or application/octet-stream).",
        "tags": [
          "secrets"
        ],
        "parameters": [
          {
            "name": "uuid",
            "in": "path",
            "description": "UUID of the item.",
            "schema": {
              "type": "string"
            },
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {}
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "text/plain": {
              "schema": {
                "type": "string"
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete secret",
        "description": "Deletes a secret and its payload.",
        "tags": [
          "secrets"
        ],
        "parameters": [
          {
            "name": "uuid",
            "in": "path",
            "description": "UUID of the item.",
            "schema": {
              "type": "string"
            },
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {}
            }
          }
        }
      }
    },
    "/v1/secrets/{uuid}/payload": {
      "get": {
        "summary": "Show secret payload",
        "description": "Returns the secret value itself. It is shown to the assistant: only read it when the user asks for it.",
        "tags": [
          "secrets"
        ],
        "parameters": [
          {
            "name": "uuid",
            "in": "path",
            "description": "UUID of the item.",
            "schema": {
              "type": "string"
            },
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {}
            }
          }
        },
        "x-openstack-mcp-dangerous": true
      }
    },
    "/v1/secrets/{uuid}/metadata": {
      "get": {
        "summary": "Show secret user metadata",

        "parameters": [
          {
            "name": "uuid",
            "in": "path",
            "description": "UUID of the item.",
            "schema": {
              "type": "string"
            },
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {}
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "read": {
                    "type": "object",
                    "properties": {
                      "users": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        },
                        "description": "User ids allowed to read."
                      },
                      "project-access": {
                        "type": "boolean",
                        "description": "Whether every member of the project can read."
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete ACL of secrets",
        "description": "Removes the access control list of the secret, back to the defaults.",
        "tags": [
          "secrets"
        ],
        "parameters": [
          {
            "name": "uuid",
            "in": "path",
            "description": "UUID of the item.",
            "schema": {
              "type": "string"

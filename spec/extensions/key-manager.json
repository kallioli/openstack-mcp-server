                  "read": {
                    "type": "object",
                    "properties": {
                      "users": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        },
                        "description": "User ids allowed to read."
                      },
                      "project-access": {
                        "type": "boolean",
                        "description": "Whether every member of the project can read."

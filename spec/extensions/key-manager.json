        "summary": "Replace ACL of secrets",
        "description": "Replaces the access control list of the secret.",
        "tags": [
          "secrets"
        ],
        "parameters": [
          {
            "name": "uuid",
            "in": "path",
            "description": "UUID of the item.",
            "schema": {
              "type": "string"
            },
            "required": true
